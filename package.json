    "dev": "pnpm --parallel --filter @theterminal/core --filter @theterminal/ui dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "6.4.6",
    "vitest": "5.0.5"
  }
}
